# Copy to apps/web/.env.local for host-based development.
# Anything prefixed with VITE_ is embedded in the browser bundle — never put a
# secret here.

# Base path the browser uses for API calls. Leave as /api so the Vite dev proxy
# (and nginx in production) forward to the API on the same origin.
VITE_API_URL=/api

# Where the Vite dev server forwards /api and /uploads.
# Host-based API: http://localhost:9000
# Docker compose:  http://api:9000   (already the default in compose.yaml)
VITE_PROXY_TARGET=http://localhost:9000
