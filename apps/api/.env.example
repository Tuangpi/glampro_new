# Copy to apps/api/.env for host-based development (`npm run dev`).
# Inside Docker these values come from .env.docker at the repository root instead.

NODE_ENV=development
PORT=9000
LOG_LEVEL=debug

# PostgreSQL. Matches the database published by `compose.yaml`
# (POSTGRES_PORT=5433), so `docker compose --env-file .env.docker up -d database`
# is all you need before `npm run dev`.
DATABASE_URL=postgresql://glampro:glampro@localhost:5433/glampro

# Only read by `prisma migrate diff --from-migrations`; point it at a throwaway database.
# SHADOW_DATABASE_URL=postgresql://glampro:glampro@localhost:5433/glampro_shadow

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Defaults to "<JWT_SECRET>-refresh" when unset.
# JWT_REFRESH_SECRET=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory for user uploads, relative to apps/api.
UPLOADS_DIR=uploads

# bcrypt work factor. Use 12 in production.
BCRYPT_ROUNDS=10

# Seed behaviour: `development` also creates demo staff accounts.
SEED_MODE=development
# ADMIN_EMAIL=admin@glampro.test
# ADMIN_NAME=Glampro Administrator
# ADMIN_PASSWORD=ChangeMe123!
