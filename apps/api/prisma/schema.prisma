generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum MembershipRole {
  ORG_OWNER
  ORG_ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  INCOMPLETE
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
  WEBHOOK
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique @db.VarChar(254)
  firstName           String                   @db.VarChar(80)
  lastName            String                   @db.VarChar(80)
  phone               String?                  @db.VarChar(40)
  avatarUrl           String?                  @db.VarChar(500)
  platformRole        PlatformRole             @default(USER)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  credential          UserCredential?
  memberships         OrganizationMembership[]
  authSessions        AuthSession[]
  resetTokens         PasswordResetToken[]
  verificationTokens  EmailVerificationToken[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationSender")
  acceptedInvitations OrganizationInvitation[] @relation("InvitationAcceptor")
  auditLogs           AuditLog[]               @relation("AuditUser")

  @@index([emailVerifiedAt])
}

model UserCredential {
  userId            String   @id
  passwordHash      String   @db.VarChar(255)
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  tokenFamilyId    String    @db.VarChar(64)
  refreshTokenHash String    @unique @db.VarChar(255)
  userAgent        String?   @db.VarChar(500)
  ipAddress        String?   @db.VarChar(64)
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id                    String                   @id @default(cuid())
  name                  String                   @db.VarChar(160)
  slug                  String                   @unique @db.VarChar(100)
  status                OrganizationStatus       @default(TRIAL)
  legalName             String?                  @db.VarChar(200)
  registrationNumber    String?                  @db.VarChar(80)
  gstRegistrationNumber String?                  @db.VarChar(80)
  defaultCurrency       String                   @default("SGD") @db.Char(3)
  defaultTimezone       String                   @default("Asia/Singapore") @db.VarChar(100)
  logoUrl               String?                  @db.VarChar(500)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  memberships           OrganizationMembership[]
  invitations           OrganizationInvitation[]
  locations             Location[]
  subscriptions         Subscription[]
  auditLogs             AuditLog[]

  @@index([status])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?        @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String           @db.VarChar(254)
  role           MembershipRole
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique @db.VarChar(255)
  invitedById    String
  acceptedById   String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id])
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([organizationId, email, status])
  @@index([expiresAt])
}

model Location {
  id                String         @id @default(cuid())
  organizationId    String
  name              String         @db.VarChar(160)
  code              String         @db.VarChar(30)
  phone             String?        @db.VarChar(40)
  email             String?        @db.VarChar(254)
  addressLine1      String?        @db.VarChar(200)
  addressLine2      String?        @db.VarChar(200)
  city              String?        @db.VarChar(100)
  postalCode        String?        @db.VarChar(30)
  countryCode       String         @default("SG") @db.Char(2)
  timezone          String         @default("Asia/Singapore") @db.VarChar(100)
  currency          String         @default("SGD") @db.Char(3)
  pricesIncludeTax  Boolean        @default(true)
  receiptPrefix     String         @default("SALE") @db.VarChar(20)
  nextReceiptNumber Int            @default(1)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours     BusinessHour[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model BusinessHour {
  id         String   @id @default(cuid())
  locationId String
  dayOfWeek  Int
  opensAt    String?  @db.Char(5)
  closesAt   String?  @db.Char(5)
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  provider               String             @default("stripe") @db.VarChar(30)
  providerCustomerId     String?            @unique @db.VarChar(120)
  providerSubscriptionId String?            @unique @db.VarChar(120)
  planCode               String             @db.VarChar(60)
  status                 SubscriptionStatus
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime?
  currentPeriodEndsAt    DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String?
  actorUserId    String?
  actorType      AuditActorType
  action         String         @db.VarChar(120)
  entityType     String?        @db.VarChar(100)
  entityId       String?        @db.VarChar(100)
  requestId      String?        @db.VarChar(100)
  ipAddress      String?        @db.VarChar(64)
  userAgent      String?        @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser      User?          @relation("AuditUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
