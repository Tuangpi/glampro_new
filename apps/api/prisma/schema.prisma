generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum MembershipRole {
  ORG_OWNER
  ORG_ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  INCOMPLETE
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
  WEBHOOK
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique @db.VarChar(254)
  firstName           String                   @db.VarChar(80)
  lastName            String                   @db.VarChar(80)
  phone               String?                  @db.VarChar(40)
  avatarUrl           String?                  @db.VarChar(500)
  platformRole        PlatformRole             @default(USER)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  credential          UserCredential?
  memberships         OrganizationMembership[]
  authSessions        AuthSession[]
  resetTokens         PasswordResetToken[]
  verificationTokens  EmailVerificationToken[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationSender")
  acceptedInvitations OrganizationInvitation[] @relation("InvitationAcceptor")
  auditLogs           AuditLog[]               @relation("AuditUser")
  inventoryMovements  InventoryMovement[]
  customerNotes       CustomerNote[]
  staffTimeOffCreated StaffTimeOff[]
  appointmentsCreated Appointment[]             @relation("AppointmentCreator")
  appointmentStatusChanges AppointmentStatusHistory[] @relation("AppointmentStatusChanger")

  @@index([emailVerifiedAt])
}

model UserCredential {
  userId            String   @id
  passwordHash      String   @db.VarChar(255)
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  tokenFamilyId    String    @db.VarChar(64)
  refreshTokenHash String    @unique @db.VarChar(255)
  userAgent        String?   @db.VarChar(500)
  ipAddress        String?   @db.VarChar(64)
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id                    String                   @id @default(cuid())
  name                  String                   @db.VarChar(160)
  slug                  String                   @unique @db.VarChar(100)
  status                OrganizationStatus       @default(TRIAL)
  legalName             String?                  @db.VarChar(200)
  registrationNumber    String?                  @db.VarChar(80)
  gstRegistrationNumber String?                  @db.VarChar(80)
  defaultCurrency       String                   @default("SGD") @db.Char(3)
  defaultTimezone       String                   @default("Asia/Singapore") @db.VarChar(100)
  logoUrl               String?                  @db.VarChar(500)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  memberships           OrganizationMembership[]
  invitations           OrganizationInvitation[]
  locations             Location[]
  subscriptions         Subscription[]
  auditLogs             AuditLog[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  productCategories     ProductCategory[]
  products              Product[]
  inventoryLevels       InventoryLevel[]
  inventoryMovements    InventoryMovement[]
  customers             Customer[]
  customerNotes         CustomerNote[]
  staffProfiles         StaffProfile[]
  staffServiceAssignments StaffServiceAssignment[]
  staffSchedules        StaffSchedule[]
  staffTimeOff          StaffTimeOff[]
  appointments          Appointment[]
  appointmentServices   AppointmentService[]
  appointmentStatusHistory AppointmentStatusHistory[]

  @@index([status])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?        @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile?

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String           @db.VarChar(254)
  role           MembershipRole
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique @db.VarChar(255)
  invitedById    String
  acceptedById   String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id])
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([organizationId, email, status])
  @@index([expiresAt])
}

model Location {
  id                String         @id @default(cuid())
  organizationId    String
  name              String         @db.VarChar(160)
  code              String         @db.VarChar(30)
  phone             String?        @db.VarChar(40)
  email             String?        @db.VarChar(254)
  addressLine1      String?        @db.VarChar(200)
  addressLine2      String?        @db.VarChar(200)
  city              String?        @db.VarChar(100)
  postalCode        String?        @db.VarChar(30)
  countryCode       String         @default("SG") @db.Char(2)
  timezone          String         @default("Asia/Singapore") @db.VarChar(100)
  currency          String         @default("SGD") @db.Char(3)
  pricesIncludeTax  Boolean        @default(true)
  receiptPrefix     String         @default("SALE") @db.VarChar(20)
  nextReceiptNumber Int            @default(1)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours     BusinessHour[]
  inventoryLevels   InventoryLevel[]
  inventoryMovements InventoryMovement[]
  appointments      Appointment[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model BusinessHour {
  id         String   @id @default(cuid())
  locationId String
  dayOfWeek  Int
  opensAt    String?  @db.Char(5)
  closesAt   String?  @db.Char(5)
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  provider               String             @default("stripe") @db.VarChar(30)
  providerCustomerId     String?            @unique @db.VarChar(120)
  providerSubscriptionId String?            @unique @db.VarChar(120)
  planCode               String             @db.VarChar(60)
  status                 SubscriptionStatus
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime?
  currentPeriodEndsAt    DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String?
  actorUserId    String?
  actorType      AuditActorType
  action         String         @db.VarChar(120)
  entityType     String?        @db.VarChar(100)
  entityId       String?        @db.VarChar(100)
  requestId      String?        @db.VarChar(100)
  ipAddress      String?        @db.VarChar(64)
  userAgent      String?        @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser      User?          @relation("AuditUser", fields: [actorUserId], references: [id], onDelete: SetNull)

    @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

enum InventoryMovementType {
  ADJUST_IN
  ADJUST_OUT
  SALE
  RETURN
  STOCK_CORRECTION
  DAMAGE
  EXPIRY
  INITIAL_STOCK
}

model ServiceCategory {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   @db.VarChar(120)
  description     String?  @db.VarChar(500)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services        Service[]

  @@index([organizationId, sortOrder])
  @@unique([organizationId, name])
}

model Service {
  id              String   @id @default(cuid())
  organizationId  String
  serviceCategoryId String
  name            String   @db.VarChar(160)
  description     String?  @db.VarChar(500)
  durationMinutes Int
  priceInCents    Int
  sortOrder       Int      @default(0)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
    organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  staffAssignments StaffServiceAssignment[]
  appointmentServices AppointmentService[]

  @@index([organizationId, sortOrder])
  @@index([organizationId, isAvailable])
}

model ProductCategory {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   @db.VarChar(120)
  description     String?  @db.VarChar(500)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products        Product[]

  @@index([organizationId, sortOrder])
  @@unique([organizationId, name])
}

model Product {
  id              String   @id @default(cuid())
  organizationId  String
  productCategoryId String
  name            String   @db.VarChar(160)
  description     String?  @db.VarChar(500)
  sku             String?  @db.VarChar(64)
  priceInCents    Int
  costInCents     Int?
  trackInventory  Boolean  @default(true)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
    organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productCategory ProductCategory @relation(fields: [productCategoryId], references: [id])
  inventoryLevels InventoryLevel[]
  inventoryMovements InventoryMovement[]

  @@index([organizationId, name])
  @@index([organizationId, isAvailable])
  @@unique([organizationId, sku])
}

model InventoryLevel {
  id              String     @id @default(cuid())
  organizationId  String
  productId       String
  locationId      String
  quantityOnHand  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id])
  location        Location     @relation(fields: [locationId], references: [id])

  @@unique([organizationId, productId, locationId])
}

model InventoryMovement {
  id              String               @id @default(cuid())
  organizationId  String
  productId       String
  locationId      String
  movementType    InventoryMovementType
  quantity        Int
  reason          String?              @db.VarChar(255)
  performedById   String?
  createdAt       DateTime             @default(now())
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         Product              @relation(fields: [productId], references: [id])
  location        Location             @relation(fields: [locationId], references: [id])
  performedBy     User?                @relation(fields: [performedById], references: [id])

  @@index([organizationId, createdAt])
  @@index([productId, locationId])
}

enum CustomerGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

/**
 * Customer profile. Email, phone, and member number are unique per organization
 * when present, so two tenants can record the same person. `isActive` is a soft
 * archive: customer rows are never deleted, because appointments and sales will
 * reference them as history.
 */
model Customer {
  id             String          @id @default(cuid())
  organizationId String
  firstName      String          @db.VarChar(80)
  lastName       String?         @db.VarChar(80)
  email          String?         @db.VarChar(254)
  phone          String?         @db.VarChar(40)
  dateOfBirth    DateTime?       @db.Date
  gender         CustomerGender?
  addressLine1   String?         @db.VarChar(200)
  addressLine2   String?         @db.VarChar(200)
  city           String?         @db.VarChar(100)
  postalCode     String?         @db.VarChar(30)
  countryCode    String          @default("SG") @db.Char(2)
  memberNumber   String?         @db.VarChar(40)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notes          CustomerNote[]
  appointments   Appointment[]

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@unique([organizationId, memberNumber])
  @@index([organizationId, isActive])
  @@index([organizationId, lastName, firstName])
}

/**
 * Append-only note on a customer profile: rows are created and read, never
 * updated, so the timeline stays an accurate record of who said what and when.
 */
model CustomerNote {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String
  authorUserId   String?
  body           String       @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author         User?        @relation(fields: [authorUserId], references: [id])

  @@index([organizationId, customerId, createdAt])
}

/**
 * Salon-operational record for one organization member. Identity (name, email)
 * stays on `OrganizationMembership.user`, so this table carries only what a
 * staff profile adds: job title, calendar colour, bookability, and hire dates.
 * `membershipId` is unique because membership IDs are globally unique cuids, so
 * the 1:1 relation also enforces one profile per membership per organization.
 */
model StaffProfile {
  id             String           @id @default(cuid())
  organizationId String
  membershipId   String           @unique
  displayName    String?          @db.VarChar(160)
  jobTitle       String?          @db.VarChar(120)
  bio            String?          @db.VarChar(500)
  color          String?          @db.Char(7)
  isBookable     Boolean          @default(true)
  hireDate       DateTime?        @db.Date
  endDate        DateTime?        @db.Date
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  serviceAssignments StaffServiceAssignment[]
  schedules      StaffSchedule[]
  timeOff        StaffTimeOff[]
  appointments   Appointment[]

  @@index([organizationId, isActive])
}

/** Which services a staff member can perform; replaced as a full set. */
model StaffServiceAssignment {
  id             String       @id @default(cuid())
  organizationId String
  staffProfileId String
  serviceId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffProfileId, serviceId])
  @@index([organizationId, serviceId])
}

/** One row per weekday, mirroring `BusinessHour`; the week is replaced as a set. */
model StaffSchedule {
  id             String       @id @default(cuid())
  organizationId String
  staffProfileId String
  dayOfWeek      Int
  startsAt       String?      @db.Char(5)
  endsAt         String?      @db.Char(5)
  isWorking      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffProfileId, dayOfWeek])
}

/** Absence window for a staff member, recorded by whoever manages the roster. */
model StaffTimeOff {
  id             String       @id @default(cuid())
  organizationId String
  staffProfileId String
  startsAt       DateTime
  endsAt         DateTime
  reason         String?      @db.VarChar(255)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId, staffProfileId, startsAt])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/**
 * One visit: a customer, one staff member, one location, and one or more
 * services. `startsAt`/`endsAt` are written by the API from the snapshotted
 * service durations rather than from live catalog rows, so editing a service
 * later cannot move an existing booking, and the staff overlap check can run
 * against indexed columns. Appointments are never hard-deleted: a cancelled or
 * no-show visit keeps its row and its status trail.
 */
model Appointment {
  id                 String            @id @default(cuid())
  organizationId     String
  locationId         String
  customerId         String
  staffProfileId     String
  status             AppointmentStatus @default(SCHEDULED)
  startsAt           DateTime
  endsAt             DateTime
  notes              String?           @db.VarChar(1000)
  cancelledAt        DateTime?
  cancellationReason String?           @db.VarChar(255)
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location           Location          @relation(fields: [locationId], references: [id])
  customer           Customer          @relation(fields: [customerId], references: [id])
  staffProfile       StaffProfile      @relation(fields: [staffProfileId], references: [id])
  createdBy          User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  services           AppointmentService[]
  statusHistory      AppointmentStatusHistory[]

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([locationId, startsAt])
  @@index([staffProfileId, startsAt, endsAt])
  @@index([customerId, startsAt])
}

/**
 * The service performed on an appointment, snapshotted at booking time. The name,
 * duration, and price are copied so the appointment survives a catalog edit, and
 * `serviceId` keeps the link back to the live row for reporting.
 */
model AppointmentService {
  id              String      @id @default(cuid())
  organizationId  String
  appointmentId   String
  serviceId       String
  name            String      @db.VarChar(160)
  durationMinutes Int
  priceInCents    Int
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment     Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service      @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, sortOrder])
  @@index([organizationId, serviceId])
}

/**
 * Append-only status trail. The first row has no `fromStatus`, because the
 * booking itself is the first state, and `changedById` is nullable so the trail
 * survives the removal of the member who made the change.
 */
model AppointmentStatusHistory {
  id             String             @id @default(cuid())
  organizationId String
  appointmentId  String
  fromStatus     AppointmentStatus?
  toStatus       AppointmentStatus
  reason         String?            @db.VarChar(255)
  changedById    String?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy      User?              @relation("AppointmentStatusChanger", fields: [changedById], references: [id])

  @@index([appointmentId, createdAt])
  @@index([organizationId, createdAt])
}


