NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://glampro:glampro@127.0.0.1:3307/glampro
SHADOW_DATABASE_URL=mysql://glampro:glampro@127.0.0.1:3307/glampro_shadow
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-different-random-characters
COOKIE_DOMAIN=
LOG_LEVEL=debug

# Session lifetimes and the email transport used for verification and password
# reset links. `log` writes messages to the API log and is ignored in production.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24
INVITATION_TTL_HOURS=168
EMAIL_TRANSPORT=log

# Integration tests use their own database and refuse to run against one whose
# name does not end in _test. Defaults to `glampro_test` on the same server.
# DATABASE_URL_TEST=mysql://glampro:glampro@127.0.0.1:3307/glampro_test

# Stripe Billing is wired in a later milestone. Keep these blank locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=