{
  "name": "glampro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @glampro/contracts && npm run build -w @glampro/api && npm run build -w @glampro/web",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w @glampro/api\" \"npm run dev -w @glampro/web\"",
    "dev:api": "npm run dev -w @glampro/api",
    "dev:web": "npm run dev -w @glampro/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build -w @glampro/contracts && npm run typecheck -w @glampro/api && npm run typecheck -w @glampro/web",
    "db:generate": "npm run db:generate -w @glampro/api",
    "db:migrate": "npm run db:migrate -w @glampro/api --",
    "db:seed": "npm run db:seed -w @glampro/api",
    "db:studio": "npm run db:studio -w @glampro/api",
    "db:validate": "npm run db:validate -w @glampro/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.44.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
