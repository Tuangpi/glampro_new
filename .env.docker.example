# Docker Compose environment for `compose.yaml` (local development).
# Copy to .env.docker — that file is git-ignored.
#   cp .env.docker.example .env.docker
# Then replace every "replace-with-…" value.

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=glampro
POSTGRES_USER=glampro
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# ---- API --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Defaults to "<JWT_SECRET>-refresh" when unset.
# JWT_REFRESH_SECRET=
LOG_LEVEL=debug
BCRYPT_ROUNDS=10

# Origin the browser uses to reach the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# ---- Ports published on the host -------------------------------------------
# Other local stacks on this workstation already own 9000 (menshealth24ai) and
# 8080 (explomo-safety), so the API uses 9100 and the database 5433.
# Change them freely; only the web port matters day to day.
API_PORT=9100
WEB_PORT=5173
POSTGRES_PORT=5433

# ---- Seeding ---------------------------------------------------------------
# `development` also creates demo manager/staff/cashier accounts.
# Quote values containing spaces so `source .env.docker` also works.
SEED_MODE=development
ADMIN_EMAIL=admin@glampro.test
ADMIN_NAME="Glampro Administrator"
ADMIN_PASSWORD=ChangeMe123!
