# Environment for `compose.production.yaml` (self-contained production stack).
# Copy to .env.production — that file is git-ignored.
#   cp .env.production.example .env.production
#
# This file contains real secrets. Keep it readable only by the deploying user
# (chmod 600) and never commit it.

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=glampro
POSTGRES_USER=glampro
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# ---- API --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret
# JWT_REFRESH_SECRET=
LOG_LEVEL=info
# Production bcrypt cost.
BCRYPT_ROUNDS=12

# Public origin(s) allowed to call the API. Comma-separated.
# e.g. https://salon.example.com
CORS_ORIGINS=https://salon.example.com

# ---- Ports published on the host -------------------------------------------
# Only nginx is published; PostgreSQL and the API stay on the Docker network.
# 8090 rather than 8080 so a local stack can coexist with the sibling projects.
WEB_PORT=8090

# ---- Seeding ---------------------------------------------------------------
# `production` seeds exactly one administrator and nothing else.
SEED_MODE=production
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="System Administrator"
ADMIN_PASSWORD=replace-with-a-strong-admin-password
